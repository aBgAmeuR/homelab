# Managed by Ansible: every guest of the inventory, and the Proxmox host.
{% for host in groups['all'] | sort %}
- targets: ["{{ hostvars[host].ansible_host }}"]
  labels:
    instance: {{ host }}
    vmid: "{{ hostvars[host].vmid }}"
{% endfor %}
- targets: ["{{ monitoring_pve_node.address }}"]
  labels:
    instance: {{ monitoring_pve_node.name }}
