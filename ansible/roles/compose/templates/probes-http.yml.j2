{% set proxy = groups['reverse_proxies'] | first %}
{% set by_ip = {} %}
{% for host in groups['guests'] %}
{% set _ = by_ip.update({hostvars[host].ansible_host: host}) %}
{% endfor %}
{% for site in hostvars[proxy].caddy_sites %}
{% set ip = site.upstream | regex_replace('^https?://', '') | regex_replace(':[0-9]+$', '') %}
{% set owner = by_ip.get(ip) %}
- targets: ["https://{{ site.host }}{{ site.health_path }}"]
  labels:
    site: {{ site.host }}
    proxy_vmid: "{{ hostvars[proxy].vmid }}"
{% if owner %}
    instance: {{ owner }}
    vmid: "{{ hostvars[owner].vmid }}"
{% elif ip == monitoring_pve_node.address %}
    instance: {{ monitoring_pve_node.name }}
{% else %}
    instance: {{ ip }}
{% endif %}
{% endfor %}
