TINYAUTH_APPURL={{ auth_tinyauth_app_url }}
TINYAUTH_LABELPROVIDER=none
TINYAUTH_ANALYTICS_ENABLED=false
TINYAUTH_SERVER_ADDRESS=0.0.0.0
TINYAUTH_SERVER_PORT={{ auth_tinyauth_port }}
TINYAUTH_DATABASE_PATH={{ auth_tinyauth_data_dir }}/tinyauth.db
TINYAUTH_AUTH_SECURECOOKIE=true
TINYAUTH_AUTH_TRUSTEDPROXIES={{ auth_tinyauth_trusted_proxies }}
TINYAUTH_LDAP_ADDRESS=ldap://127.0.0.1:{{ auth_lldap_ldap_port }}
TINYAUTH_LDAP_BINDDN={{ auth_lldap_bind_dn }}
TINYAUTH_LDAP_BINDPASSWORD={{ auth_lldap_bind_password }}
TINYAUTH_LDAP_BASEDN={{ auth_lldap_base_dn }}
TINYAUTH_LDAP_SEARCHFILTER=(uid=%s)
TINYAUTH_LDAP_INSECURE=true
TINYAUTH_OIDC_PRIVATEKEYPATH={{ auth_tinyauth_data_dir }}/oidc_key
TINYAUTH_OIDC_PUBLICKEYPATH={{ auth_tinyauth_data_dir }}/oidc_key.pub
TINYAUTH_OIDC_CLIENTS_{{ auth_tinyauth_oidc_client_name | upper }}_CLIENTID={{ grafana_oidc_client_id }}
TINYAUTH_OIDC_CLIENTS_{{ auth_tinyauth_oidc_client_name | upper }}_CLIENTSECRET={{ grafana_oidc_client_secret }}
TINYAUTH_OIDC_CLIENTS_{{ auth_tinyauth_oidc_client_name | upper }}_TRUSTEDREDIRECTURIS={{ auth_tinyauth_oidc_redirect_uri }}
TINYAUTH_OIDC_CLIENTS_{{ auth_tinyauth_oidc_client_name | upper }}_NAME=Grafana
