[Unit]
Description=LLDAP
After=network.target

[Service]
Type=simple
User={{ lldap_user }}
Group={{ lldap_user }}
WorkingDirectory={{ lldap_data_dir }}
EnvironmentFile={{ lldap_env_file }}
ExecStart={{ lldap_binary }} run --config-file {{ lldap_config }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
