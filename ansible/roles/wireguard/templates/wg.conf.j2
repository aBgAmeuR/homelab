# Managed by Ansible. Peers live in inventory/group_vars/vpn_servers.yml.
[Interface]
Address = {{ wireguard_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_private_key }}
PostUp = nft -f /etc/wireguard/{{ wireguard_interface }}.nft
PostDown = nft delete table ip {{ wireguard_interface }}
{% for peer in wireguard_peers %}

[Peer]
# {{ peer.name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.address }}/32
{% endfor %}
