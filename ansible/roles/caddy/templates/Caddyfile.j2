{
	metrics {
		per_host
		otlp
	}
}

{% for site in caddy_sites %}
{{ site.host }} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
	tracing {
		span reverse_proxy
	}
{% if site.forward_auth | default(false) %}
	@protected not path {{ site.health_path }}
	forward_auth @protected {{ caddy_forward_auth_upstream }} {
		uri /api/auth/caddy
	}
{% endif %}
	reverse_proxy {{ site.upstream }}
}

{% endfor %}
