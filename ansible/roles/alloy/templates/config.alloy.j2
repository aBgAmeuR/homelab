{% set units = (alloy_systemd_units + ['alloy.service']) | unique %}
{% set scrape_targets = alloy_scrape_targets + ([{'job': 'cadvisor', 'address': alloy_cadvisor_address}] if alloy_docker else []) %}
logging {
  level  = "warn"
  format = "logfmt"
}

prometheus.remote_write "monitoring" {
  endpoint {
    url = {{ alloy_prometheus_url | to_json }}
  }
{% if alloy_vmid | string | length > 0 %}

  external_labels = {
    vmid = {{ alloy_vmid | string | to_json }},
  }
{% endif %}
}

{% if not alloy_node %}
// Hardware collectors have nothing to read in an LXC.
// diskstats would report the host's block devices, not the guest's I/O
// (pve-exporter has that), and logs a udev error at start.
{% endif %}
prometheus.exporter.unix "host" {
  enable_collectors  = ["systemd"]
{% if alloy_node %}
  disable_collectors = [
    "arp", "bcache", "bonding", "btrfs", "fibrechannel", "infiniband", "ipvs",
    "nfs", "nfsd", "tapestats", "xfs",
  ]
{% else %}
  disable_collectors = [
    "arp", "bcache", "bonding", "btrfs", "cpufreq", "diskstats", "dmi", "edac",
    "fibrechannel", "hwmon", "infiniband", "ipvs", "mdadm", "nfs", "nfsd", "nvme",
    "powersupplyclass", "rapl", "schedstat", "tapestats", "thermal_zone", "xfs", "zfs",
  ]
{% endif %}

  textfile {
    directory = {{ alloy_textfile_dir | to_json }}
  }

  // Anchored by node-exporter.
  systemd {
    unit_include = `{{ units | map('regex_escape') | join('|') }}`
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "node"
  }

  rule {
    target_label = "instance"
    replacement  = {{ alloy_instance | to_json }}
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  scrape_interval = {{ alloy_scrape_interval | to_json }}
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}
{% for target in scrape_targets %}

prometheus.scrape {{ target.job | regex_replace('[^A-Za-z0-9_]', '_') | to_json }} {
  targets = [{
    __address__ = {{ target.address | to_json }},
    job         = {{ target.job | to_json }},
    instance    = {{ alloy_instance | to_json }},
  }]
  metrics_path    = {{ target.path | default('/metrics') | to_json }}
  scrape_interval = {{ alloy_scrape_interval | to_json }}
{% if target.bearer_token is defined %}
  bearer_token    = {{ target.bearer_token | to_json }}
{% endif %}
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}
{% endfor %}
{% if alloy_beyla %}

beyla.ebpf "services" {
  discovery {
    instrument {
      open_ports = {{ alloy_beyla_open_ports | to_json }}
    }
  }

  metrics {
    features = {{ alloy_beyla_features | to_json }}
  }

  name_resolver {
    sources = ["dns"]
  }
}

prometheus.scrape "beyla" {
  targets         = beyla.ebpf.services.targets
  honor_labels    = true
  scrape_interval = {{ alloy_scrape_interval | to_json }}
  forward_to      = [prometheus.relabel.beyla.receiver]
}

// Beyla also counts a client call to an instrumented guest as a virtual node
// named after the guest, and names unresolved callers "incoming". The central
// collector already reports user -> caddy from Caddy's own spans.
prometheus.relabel "beyla" {
{% if alloy_beyla_peers | length > 0 %}
  rule {
    source_labels = ["__name__", "connection_type", "server"]
    regex         = `traces_service_graph_.+;virtual_node;({{ alloy_beyla_peers | map('regex_escape') | join('|') }})`
    action        = "drop"
  }

{% endif %}
  rule {
    source_labels = ["__name__", "client", "server"]
    regex         = `traces_service_graph_.+;incoming;caddy`
    action        = "drop"
  }

  rule {
    source_labels = ["client"]
    regex         = "incoming"
    target_label  = "client"
    replacement   = "user"
  }

  forward_to = [prometheus.remote_write.monitoring.receiver]
}
{% endif %}

loki.write "monitoring" {
  endpoint {
    url = {{ alloy_loki_url | to_json }}
  }

  external_labels = {
    instance = {{ alloy_instance | to_json }},
{% if alloy_vmid | string | length > 0 %}
    vmid     = {{ alloy_vmid | string | to_json }},
{% endif %}
  }
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = `(.+)\.service`
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "system" {
  max_age       = {{ alloy_journal_max_age | to_json }}
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.journal.receiver]
}

loki.process "journal" {
  // loki.source.journal adds job="loki.source.journal.system".
  stage.label_drop {
    values = ["job"]
  }

{% for source in alloy_journal_json_units %}
  stage.match {
    selector = `{unit="{{ source.unit }}"}`

    stage.label_drop {
      values = ["level"]
    }

    stage.json {
      expressions = {
{% for field in source.fields %}
        {{ field }} = "",
{% endfor %}
      }
    }

    stage.structured_metadata {
      values = {
{% for field in source.fields %}
        {{ field }} = "",
{% endfor %}
      }
    }
  }

{% endfor %}
  forward_to = [loki.write.monitoring.receiver]
}
{% if alloy_docker %}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
{% if alloy_docker_logs_exclude | length > 0 %}

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = `{{ alloy_docker_logs_exclude | map('regex_escape') | join('|') }}`
    action        = "drop"
  }
{% endif %}

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = `/(.*)`
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.monitoring.receiver]
}
{% endif %}
